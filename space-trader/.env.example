# Copy to .env to override defaults (loaded automatically on Node 20.12+).

# HTTP port (default 3100)
PORT=3100

# Where saved games and logs go (defaults: ./.application/data and ./.application/logs)
# DATA_DIR=./.application/data
# LOG_DIR=./.application/logs

# API keys for the nooblyjs-core service APIs under /services (comma-separated).
# The game's own /api does not use them.
# NOOBLYJS_API_KEYS=

# Open the nooblyjs-core dashboards at /services without a login (development only).
# SERVICES_DASHBOARD=open

# Set when running behind a TLS-terminating proxy.
# TRUST_PROXY=1
